### 变量
@baseUrl = http://localhost:8080

### =============================================
### 0. 登录
### =============================================
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

@token = {{login.response.body.token}}

### =============================================
### FR-01 仓库
### =============================================

### 创建仓库
POST {{baseUrl}}/warehouses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "WH-001",
  "name": "华东原料仓",
  "type": "RAW_MATERIAL",
  "address": "上海市浦东新区XX路100号",
  "manager": "张三",
  "phone": "13800000001",
  "capacity": 5000
}

### 仓库列表
GET {{baseUrl}}/warehouses/list
Authorization: Bearer {{token}}

### 仓库详情
GET {{baseUrl}}/warehouses/1
Authorization: Bearer {{token}}

### 库位视图（树形）
GET {{baseUrl}}/warehouses/1/tree
Authorization: Bearer {{token}}

### 更新仓库
PUT {{baseUrl}}/warehouses/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "华东原料仓（已扩容）",
  "type": "RAW_MATERIAL",
  "status": "ENABLED",
  "capacity": 8000
}

### =============================================
### FR-01 库区
### =============================================

### 在仓库下创建存储区
POST {{baseUrl}}/warehouses/1/zones
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "Z-STORAGE-01",
  "name": "A区存储区",
  "type": "STORAGE"
}

### 在仓库下创建拣货区
POST {{baseUrl}}/warehouses/1/zones
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "Z-PICK-01",
  "name": "B区拣货区",
  "type": "PICKING"
}

### 仓库下库区列表
GET {{baseUrl}}/warehouses/1/zones/list
Authorization: Bearer {{token}}

### 库区详情
GET {{baseUrl}}/warehouse-zones/1
Authorization: Bearer {{token}}

### 更新库区
PUT {{baseUrl}}/warehouse-zones/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "A区存储区（扩容）",
  "type": "STORAGE",
  "status": "ENABLED"
}

### =============================================
### FR-01 库位
### =============================================

### 在库区下创建库位
POST {{baseUrl}}/warehouse-zones/1/locations
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "A-01-01",
  "name": "A区1排1位",
  "spec": "1.2m×1m×2m"
}

### 库区下库位列表
GET {{baseUrl}}/warehouse-zones/1/locations/list
Authorization: Bearer {{token}}

### 全局库位列表（按仓库筛选）
GET {{baseUrl}}/warehouse-locations/list?warehouseId=1
Authorization: Bearer {{token}}

### 库位详情
GET {{baseUrl}}/warehouse-locations/1
Authorization: Bearer {{token}}

### 库位完整详情（含库区+仓库）
GET {{baseUrl}}/warehouse-locations/1/detail
Authorization: Bearer {{token}}

### 更新库位
PUT {{baseUrl}}/warehouse-locations/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "A区1排1位",
  "spec": "1.2m×1m×2.2m",
  "status": "AVAILABLE"
}

### 禁用库位
PUT {{baseUrl}}/warehouse-locations/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "A区1排1位",
  "status": "DISABLED"
}

### 删除库位
DELETE {{baseUrl}}/warehouse-locations/1
Authorization: Bearer {{token}}

### 删除库区（有库位时应失败）
DELETE {{baseUrl}}/warehouse-zones/1
Authorization: Bearer {{token}}

### 删除仓库（有库区时应失败）
DELETE {{baseUrl}}/warehouses/1
Authorization: Bearer {{token}}
